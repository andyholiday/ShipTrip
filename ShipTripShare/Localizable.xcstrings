          "stringUnit": {
            "state": "translated",
            "value": "Übergabe fehlgeschlagen. Bitte erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handoff failed. Please try again."
          }
        }
      }
    },
