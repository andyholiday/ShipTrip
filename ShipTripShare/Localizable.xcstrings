      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        }
      }
    },
    "handoff.done": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An ShipTrip übergeben. Öffne ShipTrip, um die Reise zu importieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handed over to ShipTrip. Open ShipTrip to import the trip."
          }
        }
      }
    },
