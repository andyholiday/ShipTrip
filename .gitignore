# Xcode
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
/*.gcno
**/xcshareddata/WorkspaceSettings.xcsettings

# Build
build/
DerivedData/
*.moved-aside
*.ipa
*.xcuserstate

# CocoaPods
Pods/
!Podfile
!Podfile.lock

# Carthage
Carthage/Build/
Carthage/Checkouts/

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Code Injection
iOSInjectionProject/

# Secrets - NEVER commit!
*.plist.secret
Secrets.swift
**/Secrets/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Thumbnails
Thumbs.db

# IDE
*.swp
*.swo
*~
.idea/
*.iml

# Logs
*.log

# Test artifacts
*.xcresult/

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# Archives
*.xcarchive/
Testexport/

# Local coding standards
.codingstandards/

# Gate-Evidenz (Test-/Build-Belege der Orchestrierung)
.winston-evidence/

# Node-Abhaengigkeiten (Video-Toolchain unter videos/) - nie committen,
# enthaelt plattform-spezifische Binaries (ffmpeg ~43 MB, ffprobe ~17 MB)
node_modules/

# Video-Renderprojekte: generierte Artefakte (Quellen wie index.html,
# meta.json, package.json und assets/ bleiben bewusst trackbar)
videos/*/renders/
videos/*/snapshots/
videos/*/qa-final/
videos/*/.bin-tools/
videos/*/.thumbnails/

# Videodateien - Renderausgaben gehoeren nicht ins Repo.
# Hinweis: die zwei bereits getrackten App-Store-Previews unter
# marketing/release-1.7.0/app-store-connect/previews/ bleiben getrackt,
# .gitignore wirkt nicht auf bereits versionierte Dateien.
*.mp4
*.mov
*.m4v
*.webm
